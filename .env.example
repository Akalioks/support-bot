# 1) Telegram bot token from @BotFather (create a NEW bot, not the BookMe one)
BOT_TOKEN=

# 2) Gemini API key from aistudio.google.com → Get API key
GEMINI_API_KEY=

# 3) Managers' Telegram ids (from @userinfobot), several: 111,222
#    They receive "talk to a human" requests and can edit the knowledge base
ADMIN_IDS=

# true = anyone can open /admin read-only (for a public portfolio demo)
DEMO_MODE=true

BUSINESS_NAME=Nordic Home
SUPPORT_HOURS=Mon–Fri 9:00–18:00
TIMEZONE=Europe/Tallinn

# AI settings
AI_MODEL=gemini-3.5-flash
# Used in order when the main model is overloaded (comma-separated)
AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# How much the model "thinks" before replying: minimal (fastest) | low | medium | high
AI_THINKING=minimal
# Optional, $ per 1M tokens — fills the cost estimate in /admin (leave empty on the free tier)
AI_PRICE_INPUT=
AI_PRICE_OUTPUT=
HISTORY_MESSAGES=12

# Spending protection
USER_HOURLY_LIMIT=30
DAILY_AI_LIMIT=500

DATABASE_URL=sqlite+aiosqlite:///support.db
